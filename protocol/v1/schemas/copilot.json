{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-live/protocol/v1/copilot.json",
  "title": "copilot",
  "type": "object",
  "properties": {
    "type": {
      "const": "copilot"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "question",
              "gap",
              "counterpoint",
              "fact_check"
            ]
          },
          "text": {
            "type": "string"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "expires_at_ms"
        ],
        "additionalProperties": false
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "title",
          "snippet",
          "uri"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "version",
    "notes",
    "actions",
    "decisions",
    "suggestions",
    "related"
  ],
  "additionalProperties": false
}
