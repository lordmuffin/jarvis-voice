# Capture & Vault API authentication
# REQUIRED. There is no built-in default: if unset/empty the server returns 503 on every
# authenticated route. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then enter the same value as "Capture key" in the Android app settings.
JARVIS_CAPTURE_KEY=change-me

# Dangerous tools (default: off). When true, enables POST /api/v1/system/exec (shell),
# /api/v1/git/* and the agent's system_exec/git_* tools. Leave off unless you need them.
# JARVIS_ENABLE_DANGEROUS_TOOLS=false

# Optional vault override (defaults to /home/lordmuffin/Notes/00 Inbox/Voice Notes)
# VAULT_INBOX=/home/lordmuffin/Notes/00 Inbox/Voice Notes

# Optional Whisper model override (defaults to small.en)
# WHISPER_MODEL=small.en
