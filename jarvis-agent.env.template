# Copy to /home/lordmuffin/.jarvis-agent.env on .155 and chmod 600

# Vault & Capture API authentication
# Required — no default; the API returns 503 until set. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same value as "Capture key" in the Android app.
JARVIS_CAPTURE_KEY=change-me

# Enables /api/v1/system/exec, /api/v1/git/* and agent system_exec/git_* tools (default off).
# JARVIS_ENABLE_DANGEROUS_TOOLS=false

# LiveKit server
LIVEKIT_URL=ws://192.168.1.101:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiteLLM proxy (on DGX)
LITELLM_URL=http://192.168.1.93:4000
LITELLM_MODEL=qwen3-heavy

# Kokoro TTS (optional — leave blank to use LiteLLM TTS)
KOKORO_URL=http://192.168.1.43:8880/v1/audio/speech
KOKORO_VOICE=af_sky
