<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    app:boxedEdges="all">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/inst_space_12"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wear_settings_title"
                android:textColor="@color/inst_text"
                android:textSize="@dimen/inst_type_body"
                android:gravity="center"
                android:layout_marginBottom="@dimen/inst_space_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Wear.Label"
                android:text="@string/wear_api_key" />

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Wear.Input"
                android:inputType="textPassword"
                android:hint="@string/wear_hint_api_key"
                android:layout_marginBottom="@dimen/inst_space_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Wear.Label"
                android:text="@string/wear_server_url" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Wear.Input"
                android:inputType="textUri"
                android:hint="@string/wear_hint_server_url"
                android:layout_marginBottom="@dimen/inst_space_16" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Wear.Button.Primary"
                android:text="@string/wear_save" />

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
