<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    app:boxedEdges="all">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/inst_space_12"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wear_settings"
                android:textColor="@color/inst_text"
                android:textStyle="bold"
                android:textSize="@dimen/inst_type_label"
                android:gravity="center"
                android:layout_marginBottom="@dimen/inst_space_8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/inst_space_12"
                android:text="API key"
                android:textColor="@color/inst_text_2"
                android:textSize="@dimen/inst_type_meta" />

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textPassword"
                android:fontFamily="monospace"
                android:textColor="@color/inst_text"
                android:textSize="@dimen/inst_type_meta"
                android:hint="X-Jarvis-Key"
                android:textColorHint="@color/inst_text_disabled"
                android:background="@drawable/field_pill_bg"
                android:paddingStart="@dimen/inst_space_12"
                android:paddingEnd="@dimen/inst_space_12"
                android:layout_marginBottom="@dimen/inst_space_8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/inst_space_12"
                android:text="Server URL"
                android:textColor="@color/inst_text_2"
                android:textSize="@dimen/inst_type_meta" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textUri"
                android:fontFamily="monospace"
                android:textColor="@color/inst_text"
                android:textSize="@dimen/inst_type_meta"
                android:hint="https://kai.apj.dev"
                android:textColorHint="@color/inst_text_disabled"
                android:background="@drawable/field_pill_bg"
                android:paddingStart="@dimen/inst_space_12"
                android:paddingEnd="@dimen/inst_space_12"
                android:layout_marginBottom="@dimen/inst_space_12" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Save"
                android:textColor="@color/inst_on_accent"
                android:textSize="@dimen/inst_type_body"
                android:background="@drawable/btn_save_bg" />

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
