<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    app:boxedEdges="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/inst_space_12">
        android:padding="@dimen/inst_space_8">

        <!-- Recording timer, or the state glyph (■ saved, ✓ captured, ⚑ failed) -->
        <TextView
            android:id="@+id/tv_response"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/inst_text_2"
            android:textSize="@dimen/inst_type_caption"
            android:ellipsize="end"
            android:maxLines="4"
            android:text="@string/wear_tap_to_capture" />
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textColor="@color/inst_text"
            android:textSize="@dimen/inst_type_stat"
            android:visibility="gone"
            android:text="0:00" />

        <TextView
            android:id="@+id/tv_state_glyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/inst_space_8"
            android:textColor="@color/inst_text_2"
            android:textSize="@dimen/inst_type_micro"
            android:text="" />
            android:textColor="@color/inst_text"
            android:textSize="28sp"
            android:visibility="gone" />

        <!-- Record button: shared pill, 72dp round on the watch -->
        <Button
            android:id="@+id/btn_record"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="@string/wear_mic_glyph"
            android:layout_marginTop="@dimen/inst_space_8"
            android:layout_marginBottom="@dimen/inst_space_8"
            android:text="🎙"
            android:textColor="@color/inst_on_accent"
            android:textSize="28sp"
            android:contentDescription="@string/wear_start_capture"
            android:background="@drawable/btn_record_bg"
            android:stateListAnimator="@null" />

        <!-- State label -->
        <TextView
            android:id="@+id/tv_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/inst_text"
            android:textSize="@dimen/inst_type_body"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/wear_state_ready" />

        <!-- Meta line: "0:42 · 1 waiting", "Sent to Jarvis." -->
        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_4"
            android:textColor="@color/inst_error"
            android:textSize="@dimen/inst_type_meta"
            android:visibility="invisible"
            android:text="@string/wear_clock_zero" />
            android:textColor="@color/inst_text_2"
            android:textSize="@dimen/inst_type_meta"
            android:text="" />

        <TextView
            android:id="@+id/tv_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_8"
            android:text="@string/wear_gear"
            android:textColor="@color/inst_text_2"
            android:textSize="@dimen/inst_type_body"
            android:padding="@dimen/inst_space_8" />
            android:minWidth="@dimen/inst_control_md"
            android:minHeight="@dimen/inst_control_md"
            android:gravity="center"
            android:contentDescription="@string/wear_settings"
            android:text="⚙"
            android:textColor="@color/inst_text_2"
            android:textSize="@dimen/inst_type_body" />

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>
