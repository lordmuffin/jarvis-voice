<?xml version="1.0" encoding="utf-8"?>
<!--
  Instrument component styles for XML views. Colours and sizes are @color/inst_* and @dimen/inst_*
  (vendored, light + dark); nothing here hard-codes a hex value. Rules: reference/instrument.css in
  lordmuffin/instrument.
-->
<resources>

    <!-- Type -->
    <style name="Inst.Text" parent="">
        <item name="android:textColor">@color/inst_text</item>
        <item name="android:textSize">@dimen/inst_type_body</item>
    </style>
    <style name="Inst.Text.Display">
        <item name="android:textSize">@dimen/inst_type_display</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Inst.Text.Title">
        <item name="android:textSize">@dimen/inst_type_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Inst.Text.Stat">
        <item name="android:textSize">@dimen/inst_type_stat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Inst.Text.BodyLg">
        <item name="android:textSize">@dimen/inst_type_body_lg</item>
    </style>
    <style name="Inst.Text.Chat">
        <item name="android:textSize">@dimen/inst_type_chat</item>
    </style>
    <style name="Inst.Text.Caption">
        <item name="android:textColor">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_caption</item>
    </style>
    <style name="Inst.Text.Meta">
        <item name="android:textColor">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_meta</item>
    </style>
    <style name="Inst.Text.Mono">
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Inst.Text.Micro">
        <item name="android:textColor">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_micro</item>
    </style>
    <!-- Section label: 11sp, uppercase, tracked 0.08em, text-2. Write the text in normal case. -->
    <style name="Inst.Text.Label">
        <item name="android:textColor">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_label</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <!-- Tag: 9sp bold uppercase, tracked 0.1em (chips, badges, speaker tags). -->
    <style name="Inst.Text.Tag">
        <item name="android:textColor">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_tag</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Buttons: pills, 36dp; .Sm 32dp, .Lg 52dp. Disabled is dashed with a reason beside it, never colour alone. -->
    <style name="Widget.Inst.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/inst_control_md</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/inst_space_16</item>
        <item name="android:paddingEnd">@dimen/inst_space_16</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/inst_btn_secondary</item>
        <item name="android:textColor">@color/inst_btn_text_secondary</item>
    </style>
    <style name="Widget.Inst.Button.Primary">
        <item name="android:background">@drawable/inst_btn_primary</item>
        <item name="android:textColor">@color/inst_btn_text_primary</item>
    </style>
    <style name="Widget.Inst.Button.Secondary">
        <item name="android:background">@drawable/inst_btn_secondary</item>
        <item name="android:textColor">@color/inst_btn_text_secondary</item>
    </style>
    <style name="Widget.Inst.Button.Quiet">
        <item name="android:background">@drawable/inst_btn_quiet</item>
        <item name="android:textColor">@color/inst_btn_text_quiet</item>
        <item name="android:paddingStart">@dimen/inst_space_8</item>
        <item name="android:paddingEnd">@dimen/inst_space_8</item>
    </style>
    <style name="Widget.Inst.Button.Danger">
        <item name="android:background">@drawable/inst_btn_danger</item>
        <item name="android:textColor">@color/inst_btn_text_danger</item>
    </style>
    <style name="Widget.Inst.Button.Primary.Sm">
        <item name="android:minHeight">@dimen/inst_control_sm</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
        <item name="android:textSize">@dimen/inst_type_caption</item>
    </style>
    <style name="Widget.Inst.Button.Secondary.Sm">
        <item name="android:minHeight">@dimen/inst_control_sm</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
        <item name="android:textSize">@dimen/inst_type_caption</item>
    </style>
    <style name="Widget.Inst.Button.Danger.Sm">
        <item name="android:minHeight">@dimen/inst_control_sm</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
        <item name="android:textSize">@dimen/inst_type_caption</item>
    </style>
    <style name="Widget.Inst.Button.Primary.Lg">
        <item name="android:minHeight">@dimen/inst_control_lg</item>
        <item name="android:paddingStart">@dimen/inst_space_24</item>
        <item name="android:paddingEnd">@dimen/inst_space_24</item>
        <item name="android:textSize">@dimen/inst_type_body_lg</item>
    </style>

    <!-- Dialog footer buttons (AppCompat buttonBarButtonStyle family) -->
    <style name="Widget.Inst.DialogButton" parent="Widget.Inst.Button.Quiet" />
    <style name="Widget.Inst.DialogButton.Positive" parent="Widget.Inst.Button.Primary" />

    <!-- Inputs: bg fill, 1dp control stroke, 12dp radius, 36dp; accent focus ring, dashed when disabled. -->
    <style name="Widget.Inst.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/inst_input_bg</item>
        <item name="android:minHeight">@dimen/inst_control_md</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
        <item name="android:textColor">@color/inst_text</item>
        <item name="android:textColorHint">@color/inst_text_2</item>
        <item name="android:textSize">@dimen/inst_type_body</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="Widget.Inst.EditText.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.Inst.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/inst_input_bg</item>
        <item name="android:minHeight">@dimen/inst_control_md</item>
        <item name="android:popupBackground">@drawable/inst_popup_bg</item>
    </style>
    <style name="Widget.Inst.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@drawable/inst_popup_bg</item>
        <item name="android:divider">@null</item>
    </style>
    <style name="Widget.Inst.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/inst_popup_bg</item>
    </style>

    <!-- Switch: 36x20 track, 14dp knob; accent when on. -->
    <style name="Widget.Inst.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/inst_switch_track</item>
        <item name="android:thumb">@drawable/inst_switch_thumb</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">@dimen/inst_switch_width</item>
        <item name="android:minHeight">@dimen/inst_control_sm</item>
    </style>
    <style name="Widget.Inst.RadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="buttonTint">@color/inst_accent</item>
    </style>

    <!-- Segmented control (System / Light / Dark): a RadioGroup of these on inst_seg_bg. -->
    <style name="Widget.Inst.Seg" parent="">
        <item name="android:background">@drawable/inst_seg_bg</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">2dp</item>
    </style>
    <style name="Widget.Inst.Seg.Item" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/inst_seg_item</item>
        <item name="android:textColor">@color/inst_seg_text</item>
        <item name="android:textSize">@dimen/inst_type_caption</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
    </style>

    <!-- Status chip: square, 18dp, surface-2, 9sp bold caps; state colour on the text. -->
    <style name="Widget.Inst.Chip" parent="Inst.Text.Tag">
        <item name="android:background">@drawable/inst_chip_bg</item>
        <item name="android:minHeight">@dimen/inst_chip</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Inst.Chip.Live"><item name="android:textColor">@color/inst_accent</item></style>
    <style name="Widget.Inst.Chip.Progress"><item name="android:textColor">@color/inst_warning</item></style>
    <style name="Widget.Inst.Chip.Done"><item name="android:textColor">@color/inst_success</item></style>
    <style name="Widget.Inst.Chip.Failed"><item name="android:textColor">@color/inst_error</item></style>

    <!-- Banner: tint fill, 8x12dp, bold lead word in the state colour. Container is a LinearLayout. -->
    <style name="Widget.Inst.Banner" parent="">
        <item name="android:background">@drawable/inst_banner_info</item>
        <item name="android:paddingStart">@dimen/inst_space_12</item>
        <item name="android:paddingEnd">@dimen/inst_space_12</item>
        <item name="android:paddingTop">@dimen/inst_space_8</item>
        <item name="android:paddingBottom">@dimen/inst_space_8</item>
    </style>
    <style name="Widget.Inst.Banner.Success"><item name="android:background">@drawable/inst_banner_success</item></style>
    <style name="Widget.Inst.Banner.Warning"><item name="android:background">@drawable/inst_banner_warning</item></style>
    <style name="Widget.Inst.Banner.Error"><item name="android:background">@drawable/inst_banner_error</item></style>
    <style name="Widget.Inst.Banner.Text" parent="Inst.Text">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.Inst.Banner.Lead" parent="Widget.Inst.Banner.Text">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Inst.Banner.Lead.Success"><item name="android:textColor">@color/inst_success</item></style>
    <style name="Widget.Inst.Banner.Lead.Warning"><item name="android:textColor">@color/inst_warning</item></style>
    <style name="Widget.Inst.Banner.Lead.Error"><item name="android:textColor">@color/inst_error</item></style>

    <!-- Empty state: glyph, title, one hint line, centred. -->
    <style name="Widget.Inst.EmptyGlyph" parent="Inst.Text">
        <item name="android:textSize">@dimen/app_empty_glyph</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Inst.EmptyTitle" parent="Inst.Text.BodyLg">
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Inst.EmptyHint" parent="Inst.Text.Caption">
        <item name="android:gravity">center</item>
    </style>

    <!-- Dialogs: surface with a hairline, square, footer buttons quiet + primary. -->
    <style name="ThemeOverlay.Inst.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/inst_dialog_bg</item>
        <item name="android:windowTitleStyle">@style/Widget.Inst.DialogTitle</item>
        <item name="android:textColorPrimary">@color/inst_text</item>
        <item name="android:textColorSecondary">@color/inst_text_2</item>
        <item name="android:colorBackground">@color/inst_surface</item>
        <item name="colorAccent">@color/inst_accent</item>
        <item name="buttonBarButtonStyle">@style/Widget.Inst.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Inst.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Inst.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Inst.DialogButton</item>
        <item name="editTextStyle">@style/Widget.Inst.EditText</item>
    </style>
    <style name="Widget.Inst.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/inst_text</item>
        <item name="android:textSize">@dimen/inst_type_body_lg</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
