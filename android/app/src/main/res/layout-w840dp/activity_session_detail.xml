<?xml version="1.0" encoding="utf-8"?>
<!-- Unfolded (>= 840dp): summary and actions on the left, recordings and transcript on the right.
     Same ids as layout/activity_session_detail; the section tabs stay in the tree, hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    android:orientation="horizontal"
    android:paddingTop="@dimen/inst_space_16">

    <!-- Left pane -->
    <LinearLayout
        android:layout_width="@dimen/app_detail_left_pane"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/inst_space_16"
            android:paddingEnd="@dimen/inst_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_detail_title"
                    style="@style/Inst.Text.BodyLg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="@dimen/inst_type_stat"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_status"
                    style="@style/Widget.Inst.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/inst_space_8"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_meta"
                style="@style/Inst.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_4" />

            <!-- Live / finalizing notice -->
            <LinearLayout
                android:id="@+id/group_detail_notice"
                style="@style/Widget.Inst.Banner.Warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_detail_notice"
                    style="@style/Widget.Inst.Banner.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_detail_refresh"
                    style="@style/Widget.Inst.Button.Secondary.Sm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/inst_space_8"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/history_refresh" />
            </LinearLayout>
            <!-- Section toggle: Summary / Transcript / Actions (flat segmented tabs; selected state set in code) -->
            <LinearLayout
                android:id="@+id/group_detail_tabs"
                style="@style/Widget.Inst.Seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_12"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_tab_summary"
                    style="@style/LiveSess.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_tab_summary" />

                <Button
                    android:id="@+id/btn_tab_transcript"
                    style="@style/LiveSess.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_tab_transcript" />

                <Button
                    android:id="@+id/btn_tab_actions"
                    style="@style/LiveSess.Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_tab_actions" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/inst_space_8"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/sv_detail_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_16"
                android:paddingBottom="@dimen/inst_space_24"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_detail_text"
                    style="@style/Inst.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:textIsSelectable="true" />
            </ScrollView>
            <ProgressBar
                android:id="@+id/pb_detail"
                android:layout_width="@dimen/inst_control_md"
                android:layout_height="@dimen/inst_control_md"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/inst_accent"
                android:visibility="gone" />
            <!-- Load error: error banner with Retry -->
            <LinearLayout
                android:id="@+id/group_detail_error"
                style="@style/Widget.Inst.Banner.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/inst_space_16"
                android:layout_marginEnd="@dimen/inst_space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_detail_error"
                    style="@style/Widget.Inst.Banner.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btn_detail_retry"
                    style="@style/Widget.Inst.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_8"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/history_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Right pane -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/inst_space_16"
            android:paddingEnd="@dimen/inst_space_16">

            <!-- One row per recorded channel (item_audio_channel) -->
            <LinearLayout
                android:id="@+id/list_detail_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_12"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/inst_space_8"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_transcript"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_16"
                android:paddingBottom="@dimen/inst_space_24"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tv_detail_transcript_empty"
                style="@style/Widget.Inst.EmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:padding="@dimen/inst_space_16"
                android:text="@string/detail_transcript_empty"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
