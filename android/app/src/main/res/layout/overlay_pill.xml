<?xml version="1.0" encoding="utf-8"?>
<!-- The dictation pill. One view, five states: PillView.render() shows the right children. -->
<com.lordmuffin.jarvisvoice.pill.PillView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/app_pill_height"
    android:minWidth="@dimen/app_pill_min_width"
    android:elevation="@dimen/app_pill_elevation"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/inst_space_12"
        android:paddingEnd="@dimen/inst_space_12">

        <View
            android:id="@+id/pill_dot"
            android:layout_width="@dimen/inst_dot_live"
            android:layout_height="@dimen/inst_dot_live"
            android:background="@drawable/pill_dot" />

        <TextView
            android:id="@+id/pill_glyph"
            style="@style/Inst.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pill_done_glyph"
            android:textColor="@color/inst_accent"
            android:textSize="@dimen/inst_type_body_lg"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pill_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="@dimen/app_pill_spinner"
            android:layout_height="@dimen/app_pill_spinner"
            android:indeterminate="true"
            android:indeterminateTint="@color/inst_text_2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_label"
            style="@style/Inst.Text.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/inst_space_8"
            android:visibility="gone" />

        <com.lordmuffin.jarvisvoice.ui.AudioWaveformView
            android:id="@+id/waveform"
            android:layout_width="@dimen/app_pill_meter_width"
            android:layout_height="@dimen/app_pill_meter_height"
            android:layout_marginStart="@dimen/inst_space_8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_time"
            style="@style/Inst.Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/inst_space_8"
            android:textSize="@dimen/app_pill_time_text"
            android:visibility="gone" />

        <View
            android:id="@+id/pill_divider"
            android:layout_width="@dimen/inst_border_hairline"
            android:layout_height="@dimen/inst_space_24"
            android:layout_marginStart="@dimen/inst_space_12"
            android:background="@color/inst_control"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_action"
            style="@style/Inst.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/inst_space_12"
            android:textColor="@color/inst_accent"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.lordmuffin.jarvisvoice.pill.PillView>
