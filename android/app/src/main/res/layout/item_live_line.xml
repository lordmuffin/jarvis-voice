<?xml version="1.0" encoding="utf-8"?>
<!-- Utterance row: surface block, 3dp left rule (you = accent, them = them; set by LiveActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LiveSess.Utt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/inst_space_4">

    <TextView
        android:id="@+id/tv_line_time"
        style="@style/Inst.Text.Meta"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tv_line_text"
        style="@style/Inst.Text.Chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/inst_space_8"
        android:layout_weight="1"
        android:textIsSelectable="true" />
</LinearLayout>
