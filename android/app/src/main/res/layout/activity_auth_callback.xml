<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/inst_space_16">

    <ProgressBar
        android:layout_width="@dimen/inst_control_md"
        android:layout_height="@dimen/inst_control_md"
        android:indeterminate="true"
        android:indeterminateTint="@color/inst_accent" />

    <TextView
        android:id="@+id/tv_auth_message"
        style="@style/Inst.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inst_space_12"
        android:text="@string/live_signin_working" />
</LinearLayout>
