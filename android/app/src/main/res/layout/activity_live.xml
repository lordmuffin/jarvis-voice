<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_nav_total"
        android:orientation="vertical"
        android:paddingStart="@dimen/inst_space_16"
        android:paddingEnd="@dimen/inst_space_16"
        android:paddingTop="@dimen/inst_space_16">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Inst.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_title" />

            <Button
                android:id="@+id/btn_live_history"
                style="@style/Widget.Inst.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/inst_touch_target_android"
                android:text="@string/live_history" />
        </LinearLayout>

        <!-- Server row: address + channel badge, then the connection chip (and "Copilot offline"). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_live_status"
                style="@style/Inst.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_subtitle" />

            <TextView
                android:id="@+id/chip_live_copilot"
                style="@style/Widget.Inst.Chip.Progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/inst_space_8"
                android:text="@string/conn_copilot_offline"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_live_connection"
                style="@style/Widget.Inst.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/inst_space_8"
                android:text="@string/conn_idle" />
        </LinearLayout>

        <!-- Service message (tap to dismiss): warning banner -->
        <TextView
            android:id="@+id/tv_live_message"
            style="@style/LiveSess.BannerText.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_8"
            android:visibility="gone" />

        <!-- Setup (idle) -->
        <LinearLayout
            android:id="@+id/group_live_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_16"
            android:orientation="vertical">

            <!-- Dictation overlay: the other half of the app's home (opens Settings). -->
            <LinearLayout
                android:id="@+id/row_dictation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/inst_space_12"
                android:background="@drawable/inst_row_surface"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/inst_touch_target_android"
                android:orientation="horizontal"
                android:padding="@dimen/inst_space_12">

                <View
                    android:layout_width="@dimen/inst_dot_live"
                    android:layout_height="@dimen/inst_dot_live"
                    android:background="@drawable/pill_dot"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/inst_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Inst.Text.BodyLg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_dictation_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_dictation_status"
                            style="@style/Inst.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/inst_space_8" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dictation_last"
                        style="@style/Inst.Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/Inst.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/home_dictation_open" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rg_live_mode"
                style="@style/Widget.Inst.Seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_live_solo"
                    style="@style/Widget.Inst.Seg.Item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/live_mode_solo" />

                <RadioButton
                    android:id="@+id/rb_live_meeting"
                    style="@style/Widget.Inst.Seg.Item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/live_mode_meeting" />
            </RadioGroup>

            <EditText
                android:id="@+id/et_live_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_8"
                android:hint="@string/live_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:minHeight="@dimen/inst_touch_target_android" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_live_local_only"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_8"
                android:minHeight="@dimen/inst_touch_target_android"
                android:text="@string/live_local_only"
                android:textColor="@color/inst_text"
                android:textSize="@dimen/inst_type_body" />

            <TextView
                android:id="@+id/tv_live_network"
                style="@style/Inst.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_live_start"
                style="@style/Widget.Inst.Button.Primary.Lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_12"
                android:text="@string/live_start" />

            <TextView
                android:id="@+id/tv_live_pending_header"
                style="@style/Inst.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_16"
                android:layout_marginBottom="@dimen/inst_space_4"
                android:text="@string/live_pending"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/list_live_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Recording -->
        <LinearLayout
            android:id="@+id/group_live_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_live_timer"
                    style="@style/Inst.Text.Stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/livesess_timer_zero"
                    android:textSize="@dimen/inst_type_display" />

                <Button
                    android:id="@+id/btn_live_marker"
                    style="@style/Widget.Inst.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/live_marker" />

                <Button
                    android:id="@+id/btn_live_stop"
                    style="@style/Widget.Inst.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/inst_space_8"
                    android:minHeight="@dimen/inst_touch_target_android"
                    android:text="@string/live_stop" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_live_level"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/inst_dot"
                android:layout_marginTop="@dimen/inst_space_8"
                android:max="100"
                android:progressTint="@color/inst_accent"
                android:progressBackgroundTint="@color/inst_surface_2" />

            <TextView
                android:id="@+id/tv_live_details"
                style="@style/Inst.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_8" />
        </LinearLayout>

        <!-- Copilot -->
        <TextView
            android:id="@+id/tv_live_copilot_header"
            style="@style/Inst.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_16"
            android:background="@color/inst_surface"
            android:gravity="center_vertical"
            android:minHeight="@dimen/inst_touch_target_android"
            android:paddingStart="@dimen/inst_space_12"
            android:paddingEnd="@dimen/inst_space_12"
            android:text="@string/live_copilot"
            android:textColor="@color/inst_accent"
            android:textStyle="bold"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/sv_live_copilot"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/inst_surface"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_live_copilot"
                style="@style/Inst.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/inst_space_12"
                android:paddingEnd="@dimen/inst_space_12"
                android:paddingBottom="@dimen/inst_space_12"
                android:textIsSelectable="true" />
        </ScrollView>

        <!-- Transcript -->
        <LinearLayout
            android:id="@+id/group_live_transcript_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_16"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.Inst.EmptyGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/livesess_empty_glyph" />

            <TextView
                android:id="@+id/tv_live_transcript_empty"
                style="@style/Widget.Inst.EmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_8"
                android:text="@string/live_transcript_empty" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_live_transcript"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/inst_space_12"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/inst_space_16" />
    </LinearLayout>

    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
