<?xml version="1.0" encoding="utf-8"?>
<!-- Instrument bottom bar: 56dp on surface, hairline on top, 2dp accent indicator over the current tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/inst_surface">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/inst_border_hairline"
        android:background="@color/inst_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/inst_bottombar"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_tab_record"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_record"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_record"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_record"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_record" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_chat"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_chat"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_chat"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_chat" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_history"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_history"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_history"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_history" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_settings"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_settings"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_settings" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_models"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_models"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_models"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_models"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_models"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_models" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_agent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/nav_indicator_agent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_nav_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/nav_icon_agent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_icon_agent"
                    android:textSize="@dimen/app_nav_icon"
                    android:textColor="@color/inst_text_2" />

                <TextView
                    android:id="@+id/nav_label_agent"
                    style="@style/Inst.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/inst_space_4"
                    android:text="@string/nav_label_agent" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
