<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/inst_sheet_bg">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/inst_touch_target_android"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/inst_space_16"
        android:paddingEnd="@dimen/inst_space_12">

        <TextView
            style="@style/Inst.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_sessions_title" />

        <Button
            android:id="@+id/btn_session_new"
            style="@style/Widget.Inst.Button.Primary.Sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_session_new" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/inst_border_hairline"
        android:background="@color/inst_line" />

    <!-- Session list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/app_chat_sheet_list_max"
        android:overScrollMode="never"
        android:background="@color/inst_bg"
        android:paddingTop="@dimen/inst_space_4"
        android:paddingBottom="@dimen/inst_space_8" />

</LinearLayout>
