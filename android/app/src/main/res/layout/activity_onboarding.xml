<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg">

    <!-- Step indicator dots (persistent across all steps) -->
    <LinearLayout
        android:id="@+id/dot_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/inst_space_48"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dot0"
            android:layout_width="@dimen/app_models_dot_active"
            android:layout_height="@dimen/app_models_dot"
            android:background="@color/inst_accent"
            android:layout_marginEnd="@dimen/inst_space_8" />

        <View
            android:id="@+id/dot1"
            android:layout_width="@dimen/app_models_dot"
            android:layout_height="@dimen/app_models_dot"
            android:background="@color/inst_control"
            android:layout_marginEnd="@dimen/inst_space_8" />

        <View
            android:id="@+id/dot2"
            android:layout_width="@dimen/app_models_dot"
            android:layout_height="@dimen/app_models_dot"
            android:background="@color/inst_control" />

    </LinearLayout>

    <!-- ===== STEP 0: Welcome ===== -->
    <LinearLayout
        android:id="@+id/step_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/inst_space_32"
        android:visibility="visible">

        <!-- App logo mark: accent ring with breathing dot -->
        <FrameLayout
            android:layout_width="@dimen/app_models_logo"
            android:layout_height="@dimen/app_models_logo"
            android:layout_marginBottom="@dimen/inst_space_32">

            <View
                android:layout_width="@dimen/app_models_logo"
                android:layout_height="@dimen/app_models_logo"
                android:background="@drawable/logo_circle_bg" />

            <View
                android:layout_width="@dimen/app_models_logo_dot"
                android:layout_height="@dimen/app_models_logo_dot"
                android:layout_gravity="center"
                android:background="@drawable/models_dot_accent" />

        </FrameLayout>

        <TextView
            style="@style/Inst.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginBottom="@dimen/inst_space_12" />

        <TextView
            style="@style/Inst.Text.BodyLg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/models_onb_tagline"
            android:textColor="@color/inst_text_2"
            android:gravity="center"
            android:layout_marginBottom="@dimen/inst_space_48" />

        <Button
            style="@style/Widget.Inst.Button.Primary.Lg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/models_onb_get_started"
            android:onClick="onGetStarted" />

    </LinearLayout>

    <!-- ===== STEP 1: Permissions (ScrollView so storage card doesn't overflow) ===== -->
    <ScrollView
        android:id="@+id/step_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/inst_space_24"
            android:paddingTop="@dimen/app_models_step_top"
            android:paddingBottom="@dimen/inst_space_24">

            <TextView
                style="@style/Inst.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/models_onb_permissions_title"
                android:layout_marginBottom="@dimen/inst_space_8" />

            <TextView
                style="@style/Inst.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/models_onb_permissions_intro"
                android:textColor="@color/inst_text_2"
                android:layout_marginBottom="@dimen/inst_space_24" />

            <!-- Mic permission card -->
            <LinearLayout
                android:id="@+id/card_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/permission_card_bg"
                android:paddingVertical="@dimen/inst_space_8"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_8"
                android:layout_marginBottom="@dimen/inst_space_12"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/icon_mic"
                    android:layout_width="@dimen/app_models_icon_tile"
                    android:layout_height="@dimen/app_models_icon_tile"
                    android:background="@drawable/perm_icon_bg_teal"
                    android:layout_marginEnd="@dimen/inst_space_12">

                    <ImageView
                        android:layout_width="@dimen/app_models_icon"
                        android:layout_height="@dimen/app_models_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/inst_accent"
                        android:contentDescription="@string/models_onb_mic" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Inst.Text.Chat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_mic"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Inst.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_mic_desc" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_grant_mic"
                    style="@style/Widget.Inst.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/inst_space_48"
                    android:text="@string/models_onb_grant"
                    android:onClick="onGrantMic" />

            </LinearLayout>

            <!-- Accessibility permission card -->
            <LinearLayout
                android:id="@+id/card_a11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/permission_card_bg"
                android:paddingVertical="@dimen/inst_space_8"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_8"
                android:layout_marginBottom="@dimen/inst_space_12"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/icon_a11y"
                    android:layout_width="@dimen/app_models_icon_tile"
                    android:layout_height="@dimen/app_models_icon_tile"
                    android:background="@drawable/perm_icon_bg_teal"
                    android:layout_marginEnd="@dimen/inst_space_12">

                    <ImageView
                        android:layout_width="@dimen/app_models_icon"
                        android:layout_height="@dimen/app_models_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/inst_accent"
                        android:contentDescription="@string/models_onb_a11y" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Inst.Text.Chat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_a11y"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Inst.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_a11y_desc" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_grant_a11y"
                    style="@style/Widget.Inst.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/inst_space_48"
                    android:text="@string/models_onb_grant"
                    android:onClick="onGrantAccessibility" />

            </LinearLayout>

            <!-- Overlay permission card (optional) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/permission_card_bg"
                android:paddingVertical="@dimen/inst_space_8"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_8"
                android:layout_marginBottom="@dimen/inst_space_12"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="@dimen/app_models_icon_tile"
                    android:layout_height="@dimen/app_models_icon_tile"
                    android:background="@drawable/perm_icon_bg_dim"
                    android:layout_marginEnd="@dimen/inst_space_12">

                    <ImageView
                        android:layout_width="@dimen/app_models_icon"
                        android:layout_height="@dimen/app_models_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/inst_text_2"
                        android:contentDescription="@string/models_onb_overlay_cd" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Inst.Text.Chat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/models_onb_overlay"
                            android:textStyle="bold"
                            android:layout_marginEnd="@dimen/inst_space_8" />

                        <TextView
                            style="@style/Inst.Text.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/models_onb_optional" />

                    </LinearLayout>

                    <TextView
                        style="@style/Inst.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_overlay_desc" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_grant_overlay"
                    style="@style/Widget.Inst.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/inst_space_48"
                    android:text="@string/models_onb_grant"
                    android:onClick="onGrantOverlay" />

            </LinearLayout>

            <!-- All Files Access card (optional, API 30+ only — hidden below that) -->
            <LinearLayout
                android:id="@+id/card_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/permission_card_bg"
                android:paddingVertical="@dimen/inst_space_8"
                android:paddingStart="@dimen/inst_space_16"
                android:paddingEnd="@dimen/inst_space_8"
                android:layout_marginBottom="@dimen/inst_space_32"
                android:gravity="center_vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/app_models_icon_tile"
                    android:layout_height="@dimen/app_models_icon_tile"
                    android:background="@drawable/perm_icon_bg_dim"
                    android:layout_marginEnd="@dimen/inst_space_12">

                    <ImageView
                        android:layout_width="@dimen/app_models_icon"
                        android:layout_height="@dimen/app_models_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/inst_text_2"
                        android:contentDescription="@string/models_onb_storage_cd" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Inst.Text.Chat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/models_onb_storage"
                            android:textStyle="bold"
                            android:layout_marginEnd="@dimen/inst_space_8" />

                        <TextView
                            style="@style/Inst.Text.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/models_onb_optional" />

                    </LinearLayout>

                    <TextView
                        style="@style/Inst.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/models_onb_storage_desc" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_grant_storage_onboard"
                    style="@style/Widget.Inst.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/inst_space_48"
                    android:text="@string/models_onb_grant"
                    android:onClick="onGrantStorage" />

            </LinearLayout>

            <Button
                style="@style/Widget.Inst.Button.Primary.Lg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/models_onb_continue"
                android:onClick="onContinue" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== STEP 2: All Set ===== -->
    <LinearLayout
        android:id="@+id/step_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/inst_space_32"
        android:visibility="gone">

        <!-- Animated checkmark circle -->
        <FrameLayout
            android:layout_width="@dimen/app_models_check"
            android:layout_height="@dimen/app_models_check"
            android:layout_marginBottom="@dimen/inst_space_24">

            <View
                android:layout_width="@dimen/app_models_check"
                android:layout_height="@dimen/app_models_check"
                android:background="@drawable/check_circle_bg" />

            <TextView
                style="@style/Inst.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/models_onb_check"
                android:textColor="@color/inst_accent"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <TextView
            style="@style/Inst.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/models_onb_all_set"
            android:layout_marginBottom="@dimen/inst_space_12" />

        <TextView
            style="@style/Inst.Text.Chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/models_onb_all_set_desc"
            android:textColor="@color/inst_text_2"
            android:gravity="center"
            android:layout_marginBottom="@dimen/inst_space_32" />

        <!-- Mini pill illustration (the pill is always dark, over other apps) -->
        <FrameLayout
            android:layout_width="@dimen/app_models_pill_w"
            android:layout_height="@dimen/app_models_pill_h"
            android:background="@drawable/pill_idle_bg"
            android:layout_marginBottom="@dimen/inst_space_48"
            android:layout_gravity="center_horizontal">

            <View
                android:layout_width="@dimen/app_models_pill_dot"
                android:layout_height="@dimen/app_models_pill_dot"
                android:layout_gravity="center"
                android:background="@drawable/pill_dot" />

        </FrameLayout>

        <Button
            style="@style/Widget.Inst.Button.Primary.Lg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/models_onb_start_dictating"
            android:layout_marginBottom="@dimen/inst_space_8"
            android:onClick="onFinish" />

        <Button
            style="@style/Widget.Inst.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inst_control_lg"
            android:text="@string/models_onb_open_settings"
            android:onClick="onOpenSettings" />

    </LinearLayout>

</FrameLayout>
