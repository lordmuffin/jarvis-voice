<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg">

    <!-- Task list — leaves room for input panel + bottom nav -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_chat_task_panel_reserve"
        android:clipToPadding="false"
        android:paddingTop="@dimen/inst_space_8"
        android:paddingBottom="@dimen/inst_space_8" />

    <!-- Empty state (centered in upper portion) -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_chat_task_panel_reserve"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            style="@style/Widget.Inst.EmptyGlyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_agent_empty_glyph" />

        <TextView
            style="@style/Widget.Inst.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_agent_empty_title"
            android:layout_marginTop="@dimen/inst_space_12" />

        <TextView
            style="@style/Widget.Inst.EmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_agent_empty_hint"
            android:layout_marginTop="@dimen/inst_space_4" />

    </LinearLayout>

    <!-- Input panel pinned above bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/app_chat_nav_inset"
        android:orientation="vertical"
        android:background="@color/inst_bg"
        android:paddingTop="@dimen/inst_space_8">

        <!-- Model selector + task name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/inst_space_12"
            android:paddingEnd="@dimen/inst_space_12"
            android:paddingBottom="@dimen/inst_space_4">

            <TextView
                style="@style/Inst.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_agent_model_label"
                android:layout_marginEnd="@dimen/inst_space_8" />

            <Spinner
                android:id="@+id/sp_model"
                style="@style/Widget.Inst.Spinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/inst_control_md"
                android:layout_weight="1"
                android:paddingStart="@dimen/inst_space_8"
                android:paddingEnd="@dimen/inst_space_4" />

            <EditText
                android:id="@+id/et_task_name"
                android:layout_width="0dp"
                android:layout_height="@dimen/inst_control_md"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/inst_space_8"
                android:hint="@string/chat_agent_name_hint"
                android:textSize="@dimen/inst_type_caption"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Prompt input + Run button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingStart="@dimen/inst_space_12"
            android:paddingEnd="@dimen/inst_space_12"
            android:paddingBottom="@dimen/inst_space_8">

            <EditText
                android:id="@+id/et_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minLines="2"
                android:maxLines="5"
                android:hint="@string/chat_agent_prompt_hint"
                android:paddingTop="@dimen/inst_space_12"
                android:paddingBottom="@dimen/inst_space_12"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:layout_marginEnd="@dimen/inst_space_8" />

            <Button
                android:id="@+id/btn_run_task"
                style="@style/Widget.Inst.Button.Primary.Lg"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/inst_control_lg"
                android:text="@string/chat_agent_run"
                android:textSize="@dimen/inst_type_caption"
                android:paddingStart="@dimen/inst_space_12"
                android:paddingEnd="@dimen/inst_space_12"
                android:layout_gravity="bottom" />

        </LinearLayout>

    </LinearLayout>

    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
