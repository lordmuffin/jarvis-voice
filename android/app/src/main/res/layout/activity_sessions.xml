<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inst_bg"
    android:orientation="vertical"
    android:paddingTop="@dimen/inst_space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/inst_space_16"
        android:paddingEnd="@dimen/inst_space_16">

        <TextView
            style="@style/Inst.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history_title" />

        <Button
            android:id="@+id/btn_sessions_refresh"
            style="@style/Widget.Inst.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inst_touch_target_android"
            android:text="@string/history_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sessions_subtitle"
        style="@style/Inst.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inst_space_4"
        android:layout_marginBottom="@dimen/inst_space_12"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="@dimen/inst_space_16"
        android:paddingEnd="@dimen/inst_space_16" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/inst_space_16"
            android:paddingEnd="@dimen/inst_space_16"
            android:paddingBottom="@dimen/inst_space_16" />

        <ProgressBar
            android:id="@+id/pb_sessions"
            android:layout_width="@dimen/inst_control_md"
            android:layout_height="@dimen/inst_control_md"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/inst_accent"
            android:visibility="gone" />

        <!-- Empty / error / sign-in message with its action -->
        <LinearLayout
            android:id="@+id/group_sessions_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/inst_space_16"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_sessions_message"
                style="@style/Widget.Inst.EmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_sessions_retry"
                style="@style/Widget.Inst.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_12"
                android:minHeight="@dimen/inst_touch_target_android"
                android:text="@string/history_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
