<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/inst_space_24">

    <TextView
        style="@style/Inst.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_dict_when_i_say"
        android:layout_marginBottom="@dimen/inst_space_4" />

    <EditText
        android:id="@+id/et_word_from"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/chat_dict_from_hint"
        android:inputType="text"
        android:layout_marginBottom="@dimen/inst_space_4" />

    <!-- Shown only when editing: why the spoken word is greyed out. -->
    <TextView
        android:id="@+id/tv_word_from_locked"
        style="@style/Inst.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_dict_locked"
        android:layout_marginBottom="@dimen/inst_space_16"
        android:visibility="gone" />

    <TextView
        style="@style/Inst.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_dict_replace_with"
        android:layout_marginBottom="@dimen/inst_space_4" />

    <EditText
        android:id="@+id/et_word_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/chat_dict_to_hint"
        android:inputType="text" />

</LinearLayout>
