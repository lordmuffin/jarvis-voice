<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inst_bg">

    <TextView
        style="@style/Inst.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/models_llm_model"
        android:paddingHorizontal="@dimen/inst_space_16"
        android:paddingTop="@dimen/inst_space_24"
        android:paddingBottom="@dimen/inst_space_8" />

    <TextView
        style="@style/Inst.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/models_llm_intro"
        android:paddingHorizontal="@dimen/inst_space_16"
        android:paddingBottom="@dimen/inst_space_16" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_models"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/inst_space_24" />

    <include layout="@layout/bottom_nav" />

</LinearLayout>
