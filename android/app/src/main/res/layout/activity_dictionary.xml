<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inst_bg">

    <TextView
        style="@style/Inst.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_dict_intro"
        android:padding="@dimen/inst_space_16" />

    <Button
        android:id="@+id/btn_add_entry"
        style="@style/Widget.Inst.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_dict_add"
        android:layout_marginHorizontal="@dimen/inst_space_16"
        android:layout_marginBottom="@dimen/inst_space_8" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dict"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/inst_space_8"
        android:clipToPadding="false" />

</LinearLayout>
