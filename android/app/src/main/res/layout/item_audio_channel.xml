<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/inst_space_4"
    android:background="@drawable/inst_row_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/inst_space_12">

    <Button
        android:id="@+id/btn_audio_play"
        style="@style/Widget.Inst.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/inst_touch_target_android"
        android:text="@string/detail_play" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/inst_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_audio_label"
                style="@style/Inst.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/inst_text" />

            <TextView
                android:id="@+id/tv_audio_time"
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/inst_space_4"
            android:enabled="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="@color/inst_surface_2"
            android:progressTint="@color/inst_accent"
            android:thumbTint="@color/inst_accent" />
    </LinearLayout>
</LinearLayout>
