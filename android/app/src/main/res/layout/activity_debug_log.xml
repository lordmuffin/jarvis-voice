<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inst_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/inst_space_8">

        <Button
            android:id="@+id/btn_copy_log"
            style="@style/Widget.Inst.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_debug_copy_all"
            android:layout_marginEnd="@dimen/inst_space_4" />

        <Button
            android:id="@+id/btn_clear_log"
            style="@style/Widget.Inst.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_debug_clear"
            android:layout_marginStart="@dimen/inst_space_4" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/inst_space_8">

        <TextView
            android:id="@+id/tv_log"
            style="@style/Inst.Text.Mono"
            android:textColor="@color/inst_text"
            android:textSize="@dimen/inst_type_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3" />

    </ScrollView>

</LinearLayout>
