<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/inst_row_surface"
    android:padding="@dimen/inst_space_12"
    android:layout_marginBottom="@dimen/inst_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <RadioButton
            android:id="@+id/rb_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/inst_space_48"
            android:minHeight="@dimen/inst_space_48"
            android:layout_marginEnd="@dimen/inst_space_8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_model_name"
                    style="@style/Inst.Text.BodyLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_default_badge"
                    style="@style/Inst.Text.Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/models_default_badge"
                    android:textColor="@color/inst_accent"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_model_desc"
                style="@style/Inst.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_4" />

            <TextView
                android:id="@+id/tv_model_status"
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/inst_space_4" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_action"
            style="@style/Widget.Inst.Button.Secondary.Sm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/inst_space_48"
            android:layout_marginStart="@dimen/inst_space_8" />

    </LinearLayout>

    <!-- Download progress bar — hidden when not downloading -->
    <ProgressBar
        android:id="@+id/progress_download"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inst_space_12"
        android:progressTint="@color/inst_accent"
        android:indeterminateTint="@color/inst_accent"
        android:progressBackgroundTint="@color/inst_line"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_progress_label"
        style="@style/Inst.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inst_space_4"
        android:visibility="gone" />

</LinearLayout>
