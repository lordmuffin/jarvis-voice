<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/inst_bg">

    <!-- Stats header: Last session | Lifetime -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/inst_space_16"
        android:background="@drawable/inst_row_surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_last_words"
                style="@style/Inst.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_dash" />
            <TextView
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_last_words" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_last_wpm"
                style="@style/Inst.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_dash"
                android:textColor="@color/inst_accent" />
            <TextView
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_last_wpm" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_total_words"
                style="@style/Inst.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_zero" />
            <TextView
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_total_words" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_avg_wpm"
                style="@style/Inst.Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_zero"
                android:textColor="@color/inst_accent" />
            <TextView
                style="@style/Inst.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_avg_wpm" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/inst_border_hairline"
        android:background="@color/inst_line" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/inst_space_8"
        android:clipToPadding="false" />

    <include layout="@layout/bottom_nav" />

</LinearLayout>
