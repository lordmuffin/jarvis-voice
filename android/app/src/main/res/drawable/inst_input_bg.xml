<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/inst_surface_2" />
            <stroke android:width="@dimen/inst_border_hairline" android:color="@color/inst_control"
                android:dashWidth="3dp" android:dashGap="2dp" />
            <corners android:radius="@dimen/inst_radius_field" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/inst_bg" />
            <stroke android:width="@dimen/inst_border_focus" android:color="@color/inst_accent" />
            <corners android:radius="@dimen/inst_radius_field" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/inst_bg" />
            <stroke android:width="@dimen/inst_border_hairline" android:color="@color/inst_control" />
            <corners android:radius="@dimen/inst_radius_field" />
        </shape>
    </item>
</selector>
